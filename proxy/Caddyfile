# The single public entrypoint: TLS, static frontend, /api and /webhook
# reverse-proxied to the backend -- see docs/03-system-architecture.md #3.1
# and docs/18-deployment-and-operations.md #18.1.
#
# {$PUBLIC_URL} lets a self-hoster point this at their real domain (which
# also switches Caddy to automatic HTTPS); it defaults to plain HTTP on
# :80 for local `docker compose up`.
{$PUBLIC_URL:http://localhost} {
	encode gzip

	# /webhook/* and /webhook-test/* live outside /api/v1 deliberately
	# (docs/11-api-design.md #11.12): third-party services register these
	# URLs permanently and they must survive an API version bump untouched.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /webhook/* {
		reverse_proxy api:8000
	}
	handle /webhook-test/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:80
	}
}
