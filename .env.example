# Compose-level configuration for `docker compose up` --
# docs/18-deployment-and-operations.md #18.4.
#
# Copy to .env and fill in real values before starting the stack:
#   cp .env.example .env

ENVIRONMENT=local

# Postgres and Redis are provisioned externally (e.g. Dokploy-managed
# instances) rather than by this compose file -- see the note at the top of
# docker-compose.yml. Use the internal hostname Dokploy gives each service
# if this stack runs on the same host/network; use its public host:port
# otherwise.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/neuroflow
REDIS_URL=redis://host:6379/0

# Generate both with: openssl rand -base64 32
# No defaults are provided on purpose -- migrate/api/worker/scheduler all
# refuse to start without them (docs/15-security-and-credentials.md #15.5).
SECRET_KEY=
CREDENTIAL_MASTER_KEY=

# The public URL, used by the backend to build webhook URLs. Set to your
# real domain -- the host's own nginx handles TLS in front of this (see
# proxy/neuroflow.conf), this compose file has no reverse-proxy container.
PUBLIC_URL=https://neuroflow.example.com
CORS_ORIGINS=["https://neuroflow.example.com"]

# Ports the api/web containers publish to 127.0.0.1 for the host's nginx to
# reverse-proxy to -- see proxy/neuroflow.conf.
API_PORT=8000
WEB_PORT=3000

LOG_LEVEL=info
